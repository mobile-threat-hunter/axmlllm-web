+    string(REPLACE "${old}" "${new}" _text "${_text}")
+    get_filename_component(_name ${src} NAME)
+    file(WRITE ${CMAKE_BINARY_DIR}/aosp_patched/${_name} "${_text}")
+    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${src})
+  endfunction()
