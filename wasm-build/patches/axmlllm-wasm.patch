+#ifdef __EMSCRIPTEN__
+// liblog's host stderr logger calls its GetThreadId(), which has no branch for
+// emscripten (no __BIONIC__/__APPLE__/__linux__/_WIN32) — a missing return the
+// optimizer lowers to `unreachable`, so the FIRST AOSP log line traps the wasm
+// module. Install the same format minus the tid before any AOSP code can log.
+static void emscripten_stderr_logger(const struct __android_log_message* m) {
+  static const char log_characters[] = "XXVDIWEF";
+  int32_t priority = m->priority > ANDROID_LOG_SILENT ? ANDROID_LOG_FATAL : m->priority;
+  char priority_char = log_characters[priority];
+  const char* tag = m->tag ? m->tag : " nullptr";
+  if (m->file != nullptr)
+    fprintf(stderr, "%c %-8s: %s:%u %s\n", priority_char, tag, m->file, m->line, m->message);
+  else
+    fprintf(stderr, "%c %-8s: %s\n", priority_char, tag, m->message);
+}
+#endif
+
